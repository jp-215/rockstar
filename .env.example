# Copy to .env (or export in your shell). Everything is optional: missing values mean local mocks.

# Brain. With a key and internet, agents use Claude (claude-opus-5-5). Without (or offline), they use
# deterministic templates. A local Ollama model is optional and off by default (OLLAMA_ENABLED=1).
ANTHROPIC_API_KEY=
OLLAMA_ENABLED=0
OLLAMA_URL=http://localhost:11434
# Leave blank to auto-pick the smallest installed model (llama3.2:1b preferred; `ollama pull llama3.2:1b`)
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=60000
# Pin a provider for demos/tests: claude | ollama | template
MESH_PROVIDER=
# Start with the "wifi off" behaviour forced on
MESH_FORCE_OFFLINE=0
# Override promo duration (minutes) so the TV countdown fits a demo
MESH_PROMO_MINUTES=

# Real Slack (Socket Mode app with chat:write + interactivity). All three required, else the mock console is used.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=#storefront-ops

# Real Telegram bot (long polling). Else the mock phones in the console are used.
TELEGRAM_BOT_TOKEN=
