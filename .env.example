# Copy to .env (or export in your shell). Everything is optional: missing values mean local mocks.

# ---- Text brain (manager, communication, inventory, analytics, campaign copy)
# With a key and internet the agents use Claude (claude-opus-5-5); otherwise deterministic templates.
ANTHROPIC_API_KEY=
# Optional local text model via Ollama (off by default). On the cluster: OLLAMA_ENABLED=1 OLLAMA_MODEL=qwen3:4b
OLLAMA_ENABLED=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=60000
# Pin a provider for demos/tests: claude | ollama | template
MESH_PROVIDER=
MESH_FORCE_OFFLINE=0

# ---- Image brain (campaign agent). Ollama's experimental image endpoint (FLUX.2 Klein / Z-Image).
# Off by default; the SVG poster renderer is always used as the floor.
OLLAMA_IMAGE_ENABLED=0
OLLAMA_IMAGE_MODEL=flux2-klein:4b
OLLAMA_IMAGE_TIMEOUT_MS=180000

# ---- Owner channel: Telegram. Only the manager agent uses it. Both required, else the console mock.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
# Public base URL of the backend so Telegram can fetch campaign images (ngrok / cluster ingress)
MESH_PUBLIC_BASE=http://localhost:8787

# ---- Customer channels: AppleScript on macOS (communication agent)
# Notifications are on by default on macOS; set 0 to mock. iMessage is dry-run unless COMMS_IMESSAGE=1.
COMMS_APPLESCRIPT=1
COMMS_IMESSAGE=0

# ---- Demo knobs
MESH_PROMO_MINUTES=      # override campaign duration (minutes) so the TV countdown fits a demo
MESH_DAY_SEC=600         # sim-seconds per store day for inventory expiry
